# =====================================================================
# 🌆 City Intelligence AI Agent - Environment Configuration
# =====================================================================
# INSTRUCTIONS:
# 1. Duplicate or rename this file to ".env":
#      cp .env.example .env
# 2. Replace each placeholder below with your personal API keys.
# 3. NEVER commit your actual ".env" file to GitHub (kept in .gitignore).
# =====================================================================

# ---------------------------------------------------------------------
# 1. Groq Cloud API Key (LLM Inference)
# ---------------------------------------------------------------------
# Powers ultra-fast model reasoning (e.g., openai/gpt-oss-20b).
# Get your free API key here: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# ---------------------------------------------------------------------
# 2. OpenWeatherMap API Key (Weather Metrics)
# ---------------------------------------------------------------------
# Fetches real-time temperature, humidity, and atmospheric conditions.
# Get your free API key here: https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweather_api_key_here

# ---------------------------------------------------------------------
# 3. Tavily AI Search API Key (Breaking News)
# ---------------------------------------------------------------------
# Provides real-time city news search and article aggregation.
# Get 1,000 free monthly requests here: https://tavily.com/
TAVILY_API_KEY=your_tavily_api_key_here
